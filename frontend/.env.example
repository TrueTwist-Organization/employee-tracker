# Set at BUILD time (Vite bakes these into the static files).

# Leave unset if the browser talks to the API on the SAME origin (recommended):
# your reverse proxy serves the SPA and forwards /api and /uploads to Node.

# Set if the API lives on another host (e.g. https://api.yourdomain.com):
# VITE_API_BASE_URL=https://api.yourdomain.com
VITE_API_BASE_URL=
