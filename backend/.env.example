# Copy to .env locally. On Vercel/Render/Railway/Fly/VPS, set these in the host dashboard.

# Required — Supabase Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Required in production — long random secret (e.g. openssl rand -base64 48)
JWT_SECRET=

# Optional — default 5001 (avoid 5000 on macOS / some clouds)
PORT=5001

# Optional — browser origins allowed to call the API (comma-separated). Example:
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# If unset, all origins are allowed (fine for local dev; set in production if you use cookies later)
ALLOWED_ORIGINS=

NODE_ENV=production

# --- Vercel (set in Vercel dashboard, not only in .env) ---
# SUPABASE_URL=Supabase project URL
# SUPABASE_SERVICE_ROLE_KEY=Supabase service role key (server-only secret)
# JWT_SECRET=long random string (required)
# ALLOWED_ORIGINS=https://your-project.vercel.app,https://yourdomain.com
# VERCEL=1 is injected by Vercel automatically
